# -------------------------------------------------------------------
# A copy of this file called .env holds the real values for your own
# computer. That one is never committed and never uploaded.
#
# On Vercel these same three names go in the dashboard instead:
# Settings, Environment Variables. Never in a file.
#
# Copy this file to .env and fill it in:
#     cp .env.example .env
# -------------------------------------------------------------------


# Where the database lives.
# Leave BOTH of these empty to use data/tera.db on your own computer,
# which is the easy way to try things without touching the live shop.
# Fill them in to work against the same database the live site uses.
#
# From: turso db show <name>
TURSO_URL=
# From: turso db tokens create <name>   (shown once, keep it safe)
TURSO_TOKEN=


# The code the menu manager asks for, behind the star in the header.
# This is the only place it is set.
#
# Empty means the menu can only be changed from this computer, which
# is fine locally and NOT fine once the site is online.
OWNER_PASSWORD=


# The port the local server uses. Leave empty and it picks 5500, or
# the next free one if something else already has it.
PORT=


# -------------------------------------------------------------------
# Supabase. The menu, the ratings, the notes, the orders and the
# photographs all live here now.
#
# On Cloudflare these same names are set in the Pages dashboard:
# Settings, Environment variables. Never in a file.
# -------------------------------------------------------------------

# Project Settings, Data API, Project URL
SUPABASE_URL=

# Project Settings, API Keys, Secret keys. Starts with sb_secret_
# This one goes past every security rule in the database, so it is the
# most dangerous value in the project. It belongs only here and in the
# Cloudflare dashboard. Never in the browser, never in git.
SUPABASE_SERVICE_KEY=


# Only for deploying from a developer machine. Cloudflare dashboard ->
# My Profile -> API Tokens -> Create Token -> "Edit Cloudflare Workers".
# Not needed by the shop itself, and not set in the Pages dashboard.
CLOUDFLARE_API_TOKEN=
